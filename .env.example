# AusWise Migration — environment configuration
# Copy to .env and fill in values as needed. None are required for demo mode.

# Port the server listens on (default 3000)
PORT=3000

# --- VEVO (Visa Entitlement Verification for Organisations) -------------------
# Leave blank to run in DEMO mode (simulated, clearly-labelled results).
# To enable LIVE checks you must be enrolled as an organisation via the
# Home Affairs Access Manager (https://am.homeaffairs.gov.au) and obtain:
#   - an OAuth2 access token (valid 8 hours)
#   - your clientId (sent as x-api-key)
VEVO_BASE_URL=https://api.public.homeaffairs.gov.au/visa/v1/entitlements
VEVO_ACCESS_TOKEN=
VEVO_CLIENT_ID=

# --- Email notifications (form submissions) ----------------------------------
# Leave blank to log submissions to the console instead of emailing.
# Option A — one-line SMTP URL:
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# Option B — discrete fields (Gmail example shown; use a Gmail App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_gmail_app_password
# Where submission alerts are sent (defaults to the business inbox):
NOTIFY_EMAIL=anmolr1098@gmail.com
# From address on outgoing mail (defaults to SMTP_USER):
# MAIL_FROM=AusWise Migration <no-reply@yourdomain.com>

# --- Stripe payments (AusWise SERVICE fees only, never government charges) ----
# Leave blank to run payments in demo mode (the UI invites an enquiry instead).
# Add your Stripe secret key (sk_test_... or sk_live_...) to enable real checkout.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=aud
# Public URL of the deployed site (used for Stripe success/cancel return links).
# If unset, it is derived from the incoming request.
PUBLIC_BASE_URL=

# --- VEVO: contract version, automatic tokens, staff access ------------------
# Which Home Affairs (Visa) Entitlements contract to use: 1.0.38 (default) or 1.0.34
VEVO_API_VERSION=1.0.38
# Instead of a static VEVO_ACCESS_TOKEN, give the machine certificate from
# Home Affairs Access Manager and tokens are fetched (mTLS) and cached for 8h:
# VEVO_CLIENT_CERT_PATH=/secrets/vevo-cert.pem
# VEVO_CLIENT_KEY_PATH=/secrets/vevo-key.pem
# or VEVO_CLIENT_PFX_PATH=/secrets/vevo.pfx  VEVO_CLIENT_PFX_PASSPHRASE=
# Live checks are only allowed for staff who enter this key (required in live mode):
VEVO_OPERATOR_KEY=

# --- Business identity (shown in the footer, policies and emails) — REQUIRED for launch
BUSINESS_TRADING_NAME=AusWise Migration
BUSINESS_LEGAL_NAME=
BUSINESS_ABN=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# State or territory whose laws govern the Terms, e.g. New South Wales
BUSINESS_JURISDICTION=
# Optional separate privacy contact (defaults to BUSINESS_EMAIL)
PRIVACY_OFFICER_EMAIL=

# --- Data protection ----------------------------------------------------------
# Encrypts agent payout bank details at rest. Payout details are refused without it.
DATA_ENCRYPTION_KEY=
# Signs unsubscribe links (defaults to DATA_ENCRYPTION_KEY)
UNSUBSCRIBE_SECRET=
# Submissions older than this many days are deleted automatically (default 730)
RETENTION_DAYS=730
